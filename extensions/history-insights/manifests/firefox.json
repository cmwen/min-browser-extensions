{
  "manifest_version": 3,
  "name": "History Insights",
  "version": "0.1.0",
  "description": "Local-first browser history insights with domain filtering, tracked active time, charts, and export.",
  "action": {
    "default_popup": "dashboard.html",
    "default_title": "History Insights"
  },
  "background": {
    "scripts": ["assets/background.js"],
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      }
    }
  },
  "permissions": ["history", "storage", "tabs"]
}

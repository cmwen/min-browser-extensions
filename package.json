{
  "name": "min-browser-extensions",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:chrome": "pnpm -r --if-present build:chrome",
    "build:edge": "pnpm -r --if-present build:edge",
    "build:safari": "pnpm -r --if-present build:safari",
    "dev": "pnpm --filter @minext/tab-workspace-manager dev",
    "format": "pnpm -r --if-present format",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:native": "pnpm -r --if-present typecheck:native"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/webextension-polyfill": "0.12.5",
    "@typescript/native-preview": "7.0.0-dev.20260619.1",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "29.1.1",
    "typescript": "7.0.1-rc",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  }
}
